@page "/ordenes-restablecimiento/crear"
@page "/ordenes-restablecimiento/editar/{IdOrden:int?}"

@using ProyectoFarmaVita.Models
@using ProyectoFarmaVita.Services.OrdenRestablecimientoServices
@using ProyectoFarmaVita.Services.DetalleOrdenResServices
@using ProyectoFarmaVita.Services.ProveedorServices
@using ProyectoFarmaVita.Services.EstadoServices
@using ProyectoFarmaVita.Services.SucursalServices
@using ProyectoFarmaVita.Services.ProductoService
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations

@inject IOrdenRestablecimientoService OrdenRestablecimientoService
@inject IDetalleOrdenResService DetalleOrdenResService
@inject IProveedorService ProveedorService
@inject IEstadoService EstadoService
@inject ISucursalService SucursalService
@inject IProductoService ProductoService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@(IdOrden.HasValue ? "Editar" : "Crear") Orden de Restablecimiento - FarmaVita</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    @if (loading)
    {
        <div class="loading-container d-flex justify-center align-center">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Class="ml-3" Typo="Typo.h6">Cargando datos...</MudText>
        </div>
    }
    else
    {
        <MudPaper Elevation="3" Class="pa-6">
            <!-- Header Section -->
            <MudGrid Class="mb-4">
                <MudItem xs="12" md="8">
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Restore" Size="Size.Large" Class="mr-3" Color="Color.Primary" />
                        <div>
                            <MudText Typo="Typo.h4" Color="Color.Primary">
                                @(IdOrden.HasValue ? "Editar Orden de Restablecimiento" : "Nueva Orden de Restablecimiento")
                            </MudText>
                            <MudText Typo="Typo.body2" Class="text-muted">
                                @(IdOrden.HasValue ? $"Modificando orden #{ordenForm.NumeroOrden}" : "Crear nueva orden de reposición de productos")
                            </MudText>
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="4" Class="d-flex justify-end align-center">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => NavigationManager.NavigateTo("/ordenes-restablecimiento"))"
                               Class="mr-3">
                        Volver a Lista
                    </MudButton>
                </MudItem>
            </MudGrid>

            <!-- Form Section -->
            <EditForm Model="@ordenForm" OnValidSubmit="OnValidSubmit">
                <DataAnnotationsValidator />

                <MudGrid>
                    <!-- Información básica de la orden -->
                    <MudItem xs="12">
                        <MudCard Elevation="2" Class="mb-4">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6" Color="Color.Primary">
                                        <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                                        Información de la Orden
                                    </MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <MudGrid>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField @bind-Value="ordenForm.NumeroOrden"
                                                      Label="Número de Orden"
                                                      Variant="Variant.Outlined"
                                                      ReadOnly="true"
                                                      Disabled="true"
                                                      HelperText="Se genera automáticamente" />
                                    </MudItem>

                                    <MudItem xs="12" sm="6">
                                        <MudSelect @bind-Value="ordenForm.IdProveedor"
                                                   Label="Proveedor"
                                                   Required="true"
                                                   Variant="Variant.Outlined"
                                                   T="int?"
                                                   Disabled="@isSubmitting"
                                                   HelperText="Seleccione el proveedor">
                                            <MudSelectItem Value="@((int?)null)">Seleccionar proveedor</MudSelectItem>
                                            @if (proveedores?.Any() == true)
                                            {
                                                @foreach (var proveedor in proveedores)
                                                {
                                                    <MudSelectItem Value="@((int?)proveedor.IdProveedor)">@proveedor.NombreProveedor</MudSelectItem>
                                                }
                                            }
                                        </MudSelect>
                                        <ValidationMessage For="@(() => ordenForm.IdProveedor)" />
                                    </MudItem>

                                    <MudItem xs="12" sm="6">
                                        <MudSelect @bind-Value="ordenForm.IdSucursal"
                                                   Label="Sucursal"
                                                   Required="true"
                                                   Variant="Variant.Outlined"
                                                   T="int?"
                                                   Disabled="@isSubmitting"
                                                   HelperText="Seleccione la sucursal">
                                            <MudSelectItem Value="@((int?)null)">Seleccionar sucursal</MudSelectItem>
                                            @if (sucursales?.Any() == true)
                                            {
                                                @foreach (var sucursal in sucursales)
                                                {
                                                    <MudSelectItem Value="@((int?)sucursal.IdSucursal)">@sucursal.NombreSucursal</MudSelectItem>
                                                }
                                            }
                                        </MudSelect>
                                        <ValidationMessage For="@(() => ordenForm.IdSucursal)" />
                                    </MudItem>

                                    <MudItem xs="12" sm="6">
                                        <MudSelect T="int?"
                                                   Label="Estado"
                                                   Required="true"
                                                   Variant="Variant.Outlined"
                                                   Value="ordenForm.IdEstado"
                                                   ValueChanged="OnEstadoChanged"
                                                   Disabled="@isSubmitting"
                                                   HelperText="Estado actual de la orden">
                                            @if (estados?.Any() == true)
                                            {
                                                @foreach (var estado in estados)
                                                {
                                                    <MudSelectItem Value="@((int?)estado.IdEstado)">
                                                        @estado.Estado1
                                                    </MudSelectItem>
                                                }
                                            }
                                        </MudSelect>
                                        <ValidationMessage For="@(() => ordenForm.IdEstado)" />
                                    </MudItem>

                                    <MudItem xs="12" sm="6">
                                        <MudDatePicker @bind-Date="fechaOrden"
                                                       Label="Fecha de la Orden"
                                                       Variant="Variant.Outlined"
                                                       DateFormat="dd/MM/yyyy"
                                                       Disabled="@isSubmitting"
                                                       HelperText="Fecha de creación de la orden" />
                                    </MudItem>

                                    <MudItem xs="12" sm="6">
                                        <MudDatePicker @bind-Date="fechaRecepcion"
                                                       Label="Fecha de Recepción"
                                                       Variant="Variant.Outlined"
                                                       DateFormat="dd/MM/yyyy"
                                                       Disabled="@isSubmitting"
                                                       HelperText="Fecha estimada de recepción (opcional)" />
                                    </MudItem>

                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="ordenForm.Observaciones"
                                                      Label="Observaciones"
                                                      Variant="Variant.Outlined"
                                                      Lines="3"
                                                      MaxLength="150"
                                                      Counter="150"
                                                      Disabled="@isSubmitting"
                                                      HelperText="Observaciones adicionales sobre la orden" />
                                    </MudItem>
                                </MudGrid>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>

                    <!-- Productos de la orden -->
                    <MudItem xs="12">
                        <MudCard Elevation="2" Class="mb-4">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6" Color="Color.Primary">
                                        <MudIcon Icon="@Icons.Material.Filled.Inventory" Class="mr-2" />
                                        Productos a Solicitar
                                    </MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <!-- Agregar producto -->
                                <MudCard Elevation="1" Class="pa-4 mb-4" Style="background-color: #f8f9fa;">
                                    <MudText Typo="Typo.subtitle2" Class="mb-3" Color="Color.Primary">Agregar Producto</MudText>
                                    <MudGrid>
                                        <MudItem xs="12" sm="4">
                                            <MudSelect Value="productoSeleccionado"
                                                       ValueChanged="@(async (int? value) => await OnProductoSeleccionadoChanged(value))"
                                                       Label="Seleccionar Producto"
                                                       Variant="Variant.Outlined"
                                                       T="int?"
                                                       Disabled="@isSubmitting"
                                                       Clearable="true">
                                                <MudSelectItem Value="@((int?)null)">Seleccionar producto</MudSelectItem>
                                                @if (productos?.Any() == true)
                                                {
                                                    @foreach (var producto in productos)
                                                    {
                                                        <MudSelectItem Value="@((int?)producto.IdProducto)">
                                                            @producto.NombreProducto
                                                        </MudSelectItem>
                                                    }
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="2">
                                            <MudNumericField @bind-Value="cantidadProducto"
                                                             Label="Cantidad"
                                                             Variant="Variant.Outlined"
                                                             Min="1"
                                                             Disabled="@isSubmitting" />
                                        </MudItem>
                                        <MudItem xs="12" sm="2">
                                            <MudNumericField @bind-Value="precioUnitario"
                                                             Label="Precio Unitario"
                                                             Variant="Variant.Outlined"
                                                             Min="0"
                                                             Step="0.01M"
                                                             Format="N2"
                                                             Disabled="@isSubmitting"
                                                             Adornment="Adornment.Start"
                                                             AdornmentText="Q." />
                                        </MudItem>
                                        <MudItem xs="12" sm="2">
                                            <MudTextField Value="@CalcularSubtotal().ToString("N2")"
                                                          Label="Subtotal"
                                                          Variant="Variant.Outlined"
                                                          ReadOnly="true"
                                                          Adornment="Adornment.Start"
                                                          AdornmentText="Q." />
                                        </MudItem>
                                        <MudItem xs="12" sm="2" Class="d-flex align-center">
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Success"
                                                       StartIcon="@Icons.Material.Filled.Add"
                                                       OnClick="AgregarProducto"
                                                       Disabled="@(!PuedeAgregarProducto() || isSubmitting)"
                                                       FullWidth="true">
                                                Agregar
                                            </MudButton>
                                        </MudItem>
                                    </MudGrid>
                                </MudCard>

                                <!-- Lista de productos agregados -->
                                @if (detallesOrden?.Any() == true)
                                {
                                    <MudTable T="DetalleOrdenRes" Items="@detallesOrden" Dense="true" Hover="true" Striped="true" Class="custom-table">
                                        <HeaderContent>
                                            <MudTh>Producto</MudTh>
                                            <MudTh>Cantidad</MudTh>
                                            <MudTh>Precio Unit.</MudTh>
                                            <MudTh>Subtotal</MudTh>
                                            <MudTh Class="acciones">Acciones</MudTh>
                                        </HeaderContent>
                                        <RowTemplate Context="detalle">
                                            <MudTd DataLabel="Producto">
                                                @{
                                                    var producto = productos?.FirstOrDefault(p => p.IdProducto == detalle.IdProducto);
                                                }
                                                <div class="d-flex align-center">
                                                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Class="mr-2" Color="Color.Primary" Size="Size.Small" />
                                                    <MudText>@(producto?.NombreProducto ?? "Producto no encontrado")</MudText>
                                                </div>
                                            </MudTd>
                                            <MudTd DataLabel="Cantidad">
                                                <MudChip T="string" Color="Color.Info" Size="Size.Small">
                                                    @detalle.CantidadSolicitada
                                                </MudChip>
                                            </MudTd>
                                            <MudTd DataLabel="Precio Unit.">
                                                <MudText>Q. @(detalle.PrecioUnitario?.ToString("N2") ?? "0.00")</MudText>
                                            </MudTd>
                                            <MudTd DataLabel="Subtotal">
                                                <MudText Style="font-weight: 600;">Q. @(detalle.Subtotal?.ToString("N2") ?? "0.00")</MudText>
                                            </MudTd>
                                            <MudTd DataLabel="Acciones" Class="acciones">
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                               Color="Color.Primary"
                                                               Size="Size.Small"
                                                               OnClick="@(() => EditarProducto(detalle))"
                                                               Title="Editar producto"
                                                               Disabled="@isSubmitting" />
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                               Color="Color.Error"
                                                               Size="Size.Small"
                                                               OnClick="@(() => EliminarProducto(detalle))"
                                                               Title="Eliminar producto"
                                                               Disabled="@isSubmitting" />
                                            </MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Info" Class="mt-4">
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                                            <MudText>No se han agregado productos a la orden. Agregue al menos un producto para continuar.</MudText>
                                        </div>
                                    </MudAlert>
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudItem>

                    <!-- Resumen -->
                    @if (detallesOrden?.Any() == true)
                    {
                        <MudItem xs="12">
                            <MudCard Elevation="2" Class="mb-4">
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6" Color="Color.Success">
                                            <MudIcon Icon="@Icons.Material.Filled.Summarize" Class="mr-2" />
                                            Resumen de la Orden
                                        </MudText>
                                    </CardHeaderContent>
                                </MudCardHeader>
                                <MudCardContent>
                                    <MudGrid>
                                        <MudItem xs="12" sm="4">
                                            <MudText Typo="Typo.body1"><strong>Total de productos:</strong> @detallesOrden.Count</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudText Typo="Typo.body1"><strong>Cantidad total:</strong> @detallesOrden.Sum(d => d.CantidadSolicitada ?? 0)</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudText Typo="Typo.h6" Color="Color.Primary">
                                                <strong>Total: Q. @CalcularTotalOrden().ToString("N2")</strong>
                                            </MudText>
                                        </MudItem>
                                    </MudGrid>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }

                    <!-- Botones de acción -->
                    <MudItem xs="12">
                        <MudCard Elevation="1" Class="pa-4">
                            <div class="d-flex justify-end">
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Secondary"
                                           StartIcon="@Icons.Material.Filled.Cancel"
                                           OnClick="Cancelar"
                                           Class="mr-3"
                                           Disabled="@isSubmitting">
                                    Cancelar
                                </MudButton>
                                <MudButton ButtonType="ButtonType.Submit"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@(isSubmitting ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.Save)"
                                           Disabled="@(isSubmitting || !detallesOrden.Any())">
                                    @if (isSubmitting)
                                    {
                                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                                        <MudText>Guardando...</MudText>
                                    }
                                    else
                                    {
                                        <MudText>@(IdOrden.HasValue ? "Actualizar" : "Crear") Orden</MudText>
                                    }
                                </MudButton>
                            </div>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            </EditForm>
        </MudPaper>
    }
</MudContainer>

<!-- Dialog para editar producto -->
<MudDialog @bind-IsVisible="@mostrarDialogoEditar" Options="@dialogOptions">
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3" />
            <MudText Typo="Typo.h6">Editar Producto</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (detalleEditando != null)
        {
            <MudGrid>
                <MudItem xs="12">
                    @{
                        var producto = productos?.FirstOrDefault(p => p.IdProducto == detalleEditando.IdProducto);
                    }
                    <MudText Typo="Typo.body1" Class="mb-4">
                        <strong>Producto:</strong> @(producto?.NombreProducto ?? "Producto no encontrado")
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="cantidadEdicion"
                                     Label="Cantidad"
                                     Variant="Variant.Outlined"
                                     Min="1" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="precioEdicion"
                                     Label="Precio Unitario"
                                     Variant="Variant.Outlined"
                                     Min="0"
                                     Step="0.01M"
                                     Format="N2"
                                     Adornment="Adornment.Start"
                                     AdornmentText="Q." />
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.body1">
                        <strong>Subtotal: Q. @((cantidadEdicion * (double)precioEdicion).ToString("N2"))</strong>
                    </MudText>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => mostrarDialogoEditar = false)">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GuardarEdicionProducto">Guardar</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .custom-table {
        border-radius: 8px;
        overflow: hidden;
    }

        .custom-table .mud-table-head {
            background-color: #f8f9fa;
        }

        .custom-table .mud-table-row:hover {
            background-color: #f0f7ff;
            transition: background-color 0.2s ease;
        }

    .loading-container {
        height: 50vh;
        padding: 2rem;
    }

    .acciones {
        width: 120px;
        text-align: center;
    }
</style>

@code {
    [Parameter] public int? IdOrden { get; set; }

    private OrdenFormModel ordenForm = new();
    private List<Proveedor> proveedores = new();
    private List<Estado> estados = new();
    private List<Sucursal> sucursales = new();
    private List<Producto> productos = new();
    private List<DetalleOrdenRes> detallesOrden = new();

    private bool loading = true;
    private bool isSubmitting = false;
    private DateTime? fechaOrden = DateTime.Now;
    private DateTime? fechaRecepcion = null;
    private int? productoSeleccionado = null;
    private int cantidadProducto = 1;
    private decimal precioUnitario = 0;
    private int? estadoAnterior = null;

    // Variables para edición de productos
    private bool mostrarDialogoEditar = false;
    private DetalleOrdenRes? detalleEditando = null;
    private int cantidadEdicion = 1;
    private decimal precioEdicion = 0;
    private DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    // Modelo para validaciones
    public class OrdenFormModel
    {
        public string? NumeroOrden { get; set; }

        [Required(ErrorMessage = "El proveedor es requerido")]
        public int? IdProveedor { get; set; }

        [Required(ErrorMessage = "La sucursal es requerida")]
        public int? IdSucursal { get; set; }

        [Required(ErrorMessage = "El estado es requerido")]
        public int? IdEstado { get; set; }

        [StringLength(150, ErrorMessage = "Las observaciones no pueden exceder los 150 caracteres")]
        public string? Observaciones { get; set; }

        public bool? Aprobada { get; set; } = false;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Console.WriteLine("Iniciando OnInitializedAsync...");
            await LoadInitialData();

            if (IdOrden.HasValue)
            {
                await LoadOrdenForEdit();
            }
            else
            {
                await SetDefaultValues();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error crítico en OnInitializedAsync: {ex.Message}");
            Console.WriteLine($"StackTrace: {ex.StackTrace}");
            Snackbar.Add($"Error al cargar los datos del formulario: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadInitialData()
    {
        try
        {
            Console.WriteLine("Cargando datos iniciales...");

            // Cargar proveedores
            proveedores = await ProveedorService.GetActiveAsync() ?? new List<Proveedor>();
            Console.WriteLine($"Proveedores cargados: {proveedores.Count}");

            // Cargar sucursales
            sucursales = await SucursalService.GetAllAsync() ?? new List<Sucursal>();
            Console.WriteLine($"Sucursales cargadas: {sucursales.Count}");

            // Cargar estados
            estados = await EstadoService.GetAllAsync() ?? new List<Estado>();
            Console.WriteLine($"Estados cargados: {estados.Count}");

            // Cargar productos
            productos = await ProductoService.GetActivosAsync() ?? new List<Producto>();
            Console.WriteLine($"Productos cargados: {productos.Count}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error crítico al cargar datos iniciales: {ex.Message}");
            Console.WriteLine($"StackTrace: {ex.StackTrace}");
            throw;
        }
    }

    private async Task SetDefaultValues()
    {
        try
        {
            Console.WriteLine("Estableciendo valores por defecto...");

            // Generar número de orden
            ordenForm.NumeroOrden = await OrdenRestablecimientoService.GenerarNumeroOrdenAsync();
            Console.WriteLine($"Número de orden generado: {ordenForm.NumeroOrden}");

            // Establecer estado por defecto (Pendiente)
            var estadoPendiente = estados?.FirstOrDefault(e =>
                !string.IsNullOrEmpty(e.Estado1) &&
                e.Estado1.ToLower().Trim() == "pendiente");

            if (estadoPendiente != null)
            {
                ordenForm.IdEstado = estadoPendiente.IdEstado;
                estadoAnterior = estadoPendiente.IdEstado;
                Console.WriteLine($"Estado por defecto establecido: {estadoPendiente.Estado1} (ID: {estadoPendiente.IdEstado})");
            }
            else
            {
                Console.WriteLine("Advertencia: No se encontró el estado 'pendiente'");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al establecer valores por defecto: {ex.Message}");
            Console.WriteLine($"StackTrace: {ex.StackTrace}");
        }
    }

    private async Task LoadOrdenForEdit()
    {
        try
        {
            Console.WriteLine($"Cargando orden para edición - ID: {IdOrden.Value}");

            var orden = await OrdenRestablecimientoService.GetByIdAsync(IdOrden.Value);
            if (orden != null)
            {
                ordenForm.NumeroOrden = orden.NumeroOrden;
                ordenForm.IdProveedor = orden.IdProveedor;
                ordenForm.IdSucursal = orden.IdSucursal;
                ordenForm.IdEstado = orden.IdEstado;
                ordenForm.Observaciones = orden.Observaciones;
                ordenForm.Aprobada = orden.Aprobada;
                fechaOrden = orden.FechaOrden;
                fechaRecepcion = orden.FechaRecepcion;
                estadoAnterior = orden.IdEstado;

                Console.WriteLine($"Datos de la orden cargados exitosamente");
                Console.WriteLine($"NumeroOrden: {orden.NumeroOrden}, Estado: {orden.IdEstado}, Aprobada: {orden.Aprobada}");

                // Cargar detalles
                var detalles = await DetalleOrdenResService.GetByOrdenIdAsync(IdOrden.Value);
                if (detalles?.Any() == true)
                {
                    detallesOrden.Clear();
                    detallesOrden.AddRange(detalles);
                    Console.WriteLine($"Detalles cargados: {detallesOrden.Count} productos");
                }
                else
                {
                    Console.WriteLine("No se encontraron detalles para la orden");
                    detallesOrden = new List<DetalleOrdenRes>();
                }

                StateHasChanged();
            }
            else
            {
                Console.WriteLine("Error: No se encontró la orden");
                throw new Exception($"No se encontró la orden con ID {IdOrden.Value}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error crítico al cargar orden para edición: {ex.Message}");
            Console.WriteLine($"StackTrace: {ex.StackTrace}");
            throw;
        }
    }

    private async Task OnProductoSeleccionadoChanged(int? nuevoProductoId)
    {
        try
        {
            productoSeleccionado = nuevoProductoId;

            if (nuevoProductoId.HasValue)
            {
                // Buscar el producto seleccionado y establecer su precio de compra
                var productoSeleccionadoObj = productos?.FirstOrDefault(p => p.IdProducto == nuevoProductoId.Value);
                if (productoSeleccionadoObj != null)
                {
                    precioUnitario = (decimal)(productoSeleccionadoObj.PrecioCompra ?? 0);
                    Console.WriteLine($"Producto seleccionado: {productoSeleccionadoObj.NombreProducto}, Precio: {precioUnitario}");
                }
                else
                {
                    precioUnitario = 0;
                    Console.WriteLine($"Advertencia: No se encontró el producto con ID {nuevoProductoId.Value}");
                }
            }
            else
            {
                precioUnitario = 0;
                Console.WriteLine("Producto deseleccionado");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en OnProductoSeleccionadoChanged: {ex.Message}");
            Console.WriteLine($"StackTrace: {ex.StackTrace}");
        }
    }

    private bool PuedeAgregarProducto()
    {
        try
        {
            return productoSeleccionado.HasValue &&
                   cantidadProducto > 0 &&
                   precioUnitario > 0 &&
                   !detallesOrden.Any(d => d.IdProducto == productoSeleccionado.Value);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en PuedeAgregarProducto: {ex.Message}");
            return false;
        }
    }

    private double CalcularSubtotal()
    {
        try
        {
            return cantidadProducto * (double)precioUnitario;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al calcular subtotal: {ex.Message}");
            return 0.0;
        }
    }

    private double CalcularTotalOrden()
    {
        try
        {
            if (detallesOrden?.Any() != true)
                return 0.0;

            var total = detallesOrden.Sum(d => d.Subtotal ?? 0);
            Console.WriteLine($"Total calculado: {total}");
            return total;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al calcular total: {ex.Message}");
            return 0.0;
        }
    }

    private void AgregarProducto()
    {
        try
        {
            if (PuedeAgregarProducto())
            {
                var subtotal = CalcularSubtotal();

                var detalle = new DetalleOrdenRes
                {
                    IdProducto = productoSeleccionado.Value,
                    CantidadSolicitada = cantidadProducto,
                    PrecioUnitario = (double)precioUnitario,
                    Subtotal = subtotal,
                    IdOrden = IdOrden, // Puede ser null para ordenes nuevas
                    Total = (decimal)subtotal,
                    Descuento = 0m,
                    Impuesto = 0m
                };

                // Validar el detalle antes de agregarlo
                ValidarTiposDetalle(detalle);

                detallesOrden.Add(detalle);

                // Limpiar selección
                productoSeleccionado = null;
                cantidadProducto = 1;
                precioUnitario = 0;

                Console.WriteLine($"Producto agregado exitosamente. Total productos: {detallesOrden.Count}");
                StateHasChanged();
            }
            else
            {
                Console.WriteLine("No se puede agregar el producto. Verificar condiciones.");

                if (!productoSeleccionado.HasValue)
                    Snackbar.Add("Debe seleccionar un producto", Severity.Warning);
                else if (cantidadProducto <= 0)
                    Snackbar.Add("La cantidad debe ser mayor a 0", Severity.Warning);
                else if (precioUnitario <= 0)
                    Snackbar.Add("El precio unitario debe ser mayor a 0", Severity.Warning);
                else if (detallesOrden.Any(d => d.IdProducto == productoSeleccionado.Value))
                    Snackbar.Add("El producto ya está agregado a la orden", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error crítico al agregar producto: {ex.Message}");
            Console.WriteLine($"StackTrace: {ex.StackTrace}");
            Snackbar.Add($"Error al agregar el producto: {ex.Message}", Severity.Error);
        }
    }

    private void EliminarProducto(DetalleOrdenRes detalle)
    {
        try
        {
            if (detalle != null)
            {
                detallesOrden.Remove(detalle);
                Console.WriteLine($"Producto eliminado exitosamente. Total productos: {detallesOrden.Count}");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar producto: {ex.Message}");
            Snackbar.Add("Error al eliminar el producto", Severity.Error);
        }
    }

    private void EditarProducto(DetalleOrdenRes detalle)
    {
        try
        {
            if (detalle != null)
            {
                detalleEditando = detalle;
                cantidadEdicion = detalle.CantidadSolicitada ?? 1;

                // Obtener el precio de compra actual del producto
                var producto = productos?.FirstOrDefault(p => p.IdProducto == detalle.IdProducto);
                precioEdicion = (decimal)(producto?.PrecioCompra ?? detalle.PrecioUnitario ?? 0);

                mostrarDialogoEditar = true;
                Console.WriteLine($"Iniciando edición de producto - ID: {detalle.IdProducto}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al iniciar edición de producto: {ex.Message}");
            Snackbar.Add("Error al editar el producto", Severity.Error);
        }
    }

    private void GuardarEdicionProducto()
    {
        try
        {
            if (detalleEditando != null)
            {
                detalleEditando.CantidadSolicitada = cantidadEdicion;
                detalleEditando.PrecioUnitario = (double)precioEdicion;
                detalleEditando.Subtotal = cantidadEdicion * (double)precioEdicion;
                detalleEditando.Total = (decimal)detalleEditando.Subtotal;

                // Validar el detalle editado
                ValidarTiposDetalle(detalleEditando);

                Console.WriteLine($"Producto editado exitosamente - ID: {detalleEditando.IdProducto}");
                mostrarDialogoEditar = false;
                detalleEditando = null;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar edición de producto: {ex.Message}");
            Snackbar.Add("Error al guardar los cambios del producto", Severity.Error);
        }
    }

    private void OnEstadoChanged(int? nuevoEstado)
    {
        try
        {
            if (!nuevoEstado.HasValue) return; // Validar que tenga valor

            var estadoAnteriorId = ordenForm.IdEstado;
            ordenForm.IdEstado = nuevoEstado.Value; // Usar .Value

            var estadoCompletado = estados?.FirstOrDefault(e =>
                !string.IsNullOrEmpty(e.Estado1) &&
                e.Estado1.ToLower().Trim() == "completado");

            if (nuevoEstado.Value == estadoCompletado?.IdEstado) // Usar .Value
            {
                if (ordenForm.Aprobada == true)
                {
                    Snackbar.Add("IMPORTANTE: Al guardar con estado 'Completado' y orden aprobada, se actualizarán automáticamente los inventarios sumando las cantidades solicitadas", Severity.Info);
                }
                else
                {
                    Snackbar.Add("ATENCIÓN: Para actualizar inventarios automáticamente, la orden debe estar APROBADA antes de completarla", Severity.Warning);
                }
            }

            Console.WriteLine($"Estado cambiado de {estadoAnteriorId} a {nuevoEstado.Value}");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en OnEstadoChanged: {ex.Message}");
        }
    }


    private async Task OnValidSubmit()
    {
        try
        {
            if (isSubmitting) return;

            // Validar que haya productos
            if (!detallesOrden.Any())
            {
                Snackbar.Add("Debe agregar al menos un producto a la orden", Severity.Error);
                return;
            }

            isSubmitting = true;
            StateHasChanged();

            Console.WriteLine("Iniciando proceso de guardado de orden...");

            // Obtener ID del usuario actual
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userIdClaim = authState.User.FindFirst("IdPersona");

            if (userIdClaim == null || !int.TryParse(userIdClaim.Value, out int userId))
            {
                Console.WriteLine("Error: No se pudo obtener el ID del usuario");
                Snackbar.Add("Error: No se pudo obtener el ID del usuario", Severity.Error);
                return;
            }

            Console.WriteLine($"Usuario autenticado: {userId}");

            var orden = new OrdenRestablecimiento
            {
                IdOrden = IdOrden ?? 0,
                NumeroOrden = ordenForm.NumeroOrden,
                IdProveedor = ordenForm.IdProveedor,
                IdSucursal = ordenForm.IdSucursal,
                IdEstado = ordenForm.IdEstado,
                IdPersonaSolicitud = userId,
                FechaOrden = fechaOrden,
                FechaRecepcion = fechaRecepcion,
                Observaciones = ordenForm.Observaciones,
                Aprobada = ordenForm.Aprobada,
                Total = CalcularTotalOrden()
            };

            Console.WriteLine($"Orden preparada - NumeroOrden: {orden.NumeroOrden}, Total: {orden.Total}");

            bool success = false;
            int ordenId = IdOrden ?? 0;

            if (IdOrden.HasValue)
            {
                Console.WriteLine($"Actualizando orden existente - ID: {IdOrden.Value}");

                // PRIMERO: Actualizar la orden
                success = await OrdenRestablecimientoService.AddUpdateAsync(orden);

                if (success)
                {
                    Console.WriteLine("Orden actualizada exitosamente");
                    ordenId = IdOrden.Value;

                    // SEGUNDO: Procesar inventarios si es necesario
                    await ProcessInventoryIfConfirmed(orden);

                    // TERCERO: Actualizar detalles
                    Console.WriteLine("Actualizando detalles de la orden...");

                    // Asegurar que todos los detalles tienen el ID de orden correcto
                    foreach (var detalle in detallesOrden)
                    {
                        detalle.IdOrden = ordenId;
                        ValidarTiposDetalle(detalle);
                    }

                    var detallesSuccess = await DetalleOrdenResService.UpdateDetallesAsync(ordenId, detallesOrden);

                    if (!detallesSuccess)
                    {
                        Console.WriteLine("Error al actualizar detalles de la orden");
                        Snackbar.Add("Error al actualizar los detalles de la orden", Severity.Error);
                        success = false;
                    }
                    else
                    {
                        Console.WriteLine("Detalles actualizados exitosamente");
                    }
                }
            }
            else
            {
                Console.WriteLine("Creando nueva orden...");
                success = await OrdenRestablecimientoService.AddUpdateAsync(orden);

                if (success && orden.IdOrden > 0)
                {
                    ordenId = orden.IdOrden;
                    Console.WriteLine($"Orden creada exitosamente con ID: {ordenId}");

                    // Actualizar ID de orden en todos los detalles
                    foreach (var detalle in detallesOrden)
                    {
                        detalle.IdOrden = ordenId;
                        ValidarTiposDetalle(detalle);
                    }

                    // Agregar detalles
                    var detallesSuccess = await DetalleOrdenResService.AddDetallesAsync(detallesOrden);

                    if (detallesSuccess)
                    {
                        Console.WriteLine("Detalles agregados exitosamente");

                        // Procesar inventarios si es necesario
                        await ProcessInventoryIfConfirmed(orden);
                    }
                    else
                    {
                        Console.WriteLine("Error al agregar detalles de la orden");
                        Snackbar.Add("Error al agregar los detalles de la orden", Severity.Error);
                        success = false;
                    }
                }
                else
                {
                    Console.WriteLine($"Error: Orden no fue creada correctamente. IdOrden resultante: {orden.IdOrden}");
                    success = false;
                }
            }

            if (success)
            {
                Snackbar.Add(IdOrden.HasValue ?
                    "Orden actualizada exitosamente" : "Orden creada exitosamente",
                    Severity.Success);
                NavigationManager.NavigateTo("/ordenes-restablecimiento");
            }
            else
            {
                Snackbar.Add("Error al guardar la orden. Verifique los datos e intente nuevamente.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error crítico en OnValidSubmit: {ex.Message}");
            Console.WriteLine($"StackTrace: {ex.StackTrace}");
            Snackbar.Add($"Error crítico al guardar la orden: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task ProcessInventoryIfConfirmed(OrdenRestablecimiento orden)
    {
        try
        {
            // Verificar si el estado es completado (ID = 4)
            var estadoCompletado = estados?.FirstOrDefault(e =>
                !string.IsNullOrEmpty(e.Estado1) &&
                e.Estado1.ToLower().Trim() == "completado");

            bool esCompletado = orden.IdEstado == estadoCompletado?.IdEstado;
            bool estaAprobada = orden.Aprobada == true;

            Console.WriteLine($"Evaluando inventarios - Estado actual: {orden.IdEstado}, Es completado: {esCompletado}, Está aprobada: {estaAprobada}");
            Console.WriteLine($"Estado Completado encontrado: ID={estadoCompletado?.IdEstado}");

            // MODIFICACIÓN PRINCIPAL: Procesar inventarios si está completado Y aprobado
            // Sin importar si cambió de estado en esta sesión
            if (esCompletado && estaAprobada)
            {
                Console.WriteLine("✅ Condiciones cumplidas - procesando inventarios: orden completada y aprobada");

                // Verificar si ya fue procesada anteriormente
                var ordenActual = await OrdenRestablecimientoService.GetByIdAsync(orden.IdOrden);
                if (ordenActual?.FechaRecepcion.HasValue == true)
                {
                    // Mostrar advertencia pero permitir re-procesar
                    var continuarProceso = await DialogService.ShowMessageBox(
                        "Orden Ya Procesada",
                        $"Esta orden ya fue procesada el {ordenActual.FechaRecepcion:dd/MM/yyyy HH:mm}.\n\n" +
                        "¿Desea volver a procesar la actualización de inventario?\n\n" +
                        "⚠️ Esto podría resultar en una suma duplicada al inventario.",
                        yesText: "Sí, Volver a Procesar",
                        cancelText: "No, Omitir");

                    if (continuarProceso != true)
                    {
                        Console.WriteLine("Usuario decidió no re-procesar la orden ya procesada");
                        Snackbar.Add("Orden guardada sin actualizar inventario (ya fue procesada anteriormente)", Severity.Info);
                        return;
                    }
                }

                // Verificar que tenga productos para procesar
                if (detallesOrden?.Any() != true)
                {
                    Console.WriteLine("⚠️ No hay productos para procesar en esta orden");
                    Snackbar.Add("No hay productos para actualizar en el inventario", Severity.Warning);
                    return;
                }

                // Mostrar mensaje de confirmación antes de procesar
                var dialog = await DialogService.ShowMessageBox(
                    "Confirmar Actualización de Inventario",
                    $"¿Está seguro de procesar la orden {orden.NumeroOrden}?\n\n" +
                    $"Esta acción sumará las cantidades solicitadas al inventario actual de la sucursal:\n" +
                    $"• Total de productos: {detallesOrden.Count}\n" +
                    $"• Cantidad total a agregar: {detallesOrden.Sum(d => d.CantidadSolicitada ?? 0)} unidades\n\n" +
                    $"Esta operación NO se puede deshacer.",
                    yesText: "Sí, Actualizar Inventario",
                    cancelText: "Cancelar");

                if (dialog == true)
                {
                    Console.WriteLine("Usuario confirmó la actualización de inventarios");
                    var processingSuccess = await OrdenRestablecimientoService.ConfirmarOrdenAsync(orden.IdOrden);

                    if (processingSuccess)
                    {
                        Snackbar.Add($"Orden procesada exitosamente. Inventarios actualizados: +{detallesOrden.Sum(d => d.CantidadSolicitada ?? 0)} unidades", Severity.Success);

                        // Log detallado para auditoría
                        Console.WriteLine("INVENTARIOS ACTUALIZADOS:");
                        foreach (var detalle in detallesOrden)
                        {
                            var producto = productos?.FirstOrDefault(p => p.IdProducto == detalle.IdProducto);
                            Console.WriteLine($"  • {producto?.NombreProducto}: +{detalle.CantidadSolicitada} unidades");
                        }
                    }
                    else
                    {
                        Snackbar.Add("Error al procesar la orden y actualizar inventarios", Severity.Error);
                        Console.WriteLine("Error en ConfirmarOrdenAsync");
                    }
                }
                else
                {
                    Console.WriteLine("Usuario canceló la actualización de inventarios");
                    Snackbar.Add("Operación cancelada por el usuario. La orden se guardó pero sin actualizar inventarios.", Severity.Warning);
                }
            }
            else if (esCompletado && !estaAprobada)
            {
                Console.WriteLine("Orden en estado completado pero NO aprobada - no se actualizarán inventarios");
                Snackbar.Add("La orden está en estado 'Completado' pero no está aprobada. Los inventarios NO se actualizarán automáticamente.", Severity.Warning);
            }
            else if (!esCompletado)
            {
                Console.WriteLine($"La orden no está en estado completado (Estado actual ID: {orden.IdEstado})");
                Snackbar.Add("Para actualizar el inventario, la orden debe estar en estado 'Completado' y aprobada.", Severity.Info);
            }
            else
            {
                Console.WriteLine("No se requiere actualización de inventarios");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error crítico al procesar inventarios: {ex.Message}");
            Console.WriteLine($"StackTrace: {ex.StackTrace}");
            Snackbar.Add($"Error al procesar los inventarios: {ex.Message}", Severity.Error);
        }
    }

    private void ValidarTiposDetalle(DetalleOrdenRes detalle)
    {
        try
        {
            // Asegurar que los tipos son correctos según el modelo
            if (detalle.Total.HasValue && detalle.Total.Value < 0)
                detalle.Total = 0m;

            if (detalle.Descuento.HasValue && detalle.Descuento.Value < 0)
                detalle.Descuento = 0m;

            if (detalle.Impuesto.HasValue && detalle.Impuesto.Value < 0)
                detalle.Impuesto = 0m;

            if (detalle.CantidadSolicitada.HasValue && detalle.CantidadSolicitada.Value < 0)
                detalle.CantidadSolicitada = 0;

            if (detalle.PrecioUnitario.HasValue && detalle.PrecioUnitario.Value < 0)
                detalle.PrecioUnitario = 0;

            if (detalle.Subtotal.HasValue && detalle.Subtotal.Value < 0)
                detalle.Subtotal = 0;

            Console.WriteLine($"Detalle validado - Producto: {detalle.IdProducto}, Cantidad: {detalle.CantidadSolicitada}, Total: {detalle.Total}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al validar detalle: {ex.Message}");
        }
    }

