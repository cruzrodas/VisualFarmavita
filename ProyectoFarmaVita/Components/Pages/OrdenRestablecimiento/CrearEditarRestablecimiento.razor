    {
        try
        {
            Console.WriteLine("Cancelando operación...");
            NavigationManager.NavigateTo("/ordenes-restablecimiento");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cancelar: {ex.Message}");
        }
    }
